
# Public Convex addresses; never place secret deploy keys in VITE_ variables.
VITE_CONVEX_URL=https://tidy-perch-115.eu-west-1.convex.cloud
VITE_CONVEX_SITE_URL=https://tidy-perch-115.eu-west-1.convex.site
# The Convex CLI writes CONVEX_DEPLOYMENT to .env.local after project selection.


# Required before production release; do not invent operator/contact details.
VITE_APP_ORIGIN=
VITE_LEGAL_ENTITY=
# Operational attestations: set true only after each check is completed.
LEGAL_REVIEW_COMPLETE=false
BACKUP_RESTORE_TESTED=false
ALERTS_CONFIGURED=false
LIVE_AUTH_TESTED=false
LEGACY_ASSET_RETENTION_CONFIRMED=false

# Enable only on the reviewed production site with VITE_APP_ORIGIN set.
# Leave false on previews and development deployments.
VITE_SITE_INDEXABLE=false

# Guest support: public widget key only. Never put its secret in a VITE_ variable.
VITE_TURNSTILE_SITE_KEY=
SUPPORT_FLOW_TESTED=false
# Configure TURNSTILE_SECRET_KEY and SUPPORT_ALLOWED_HOSTNAMES on Convex itself.
# Allowed hostnames are exact comma-separated frontend hostnames, without URLs.
